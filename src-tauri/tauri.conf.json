{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "two-factor-auth",
  "version": "0.1.0",
  "identifier": "com.linh.twofactorauth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "two-factor-auth",
        "width": 360,
        "height": 600,
        "maximized": false,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NDcxQzMxMUFERUU0ODgKUldTSTVONGFNUnhIdHphSFJlMFFVbzU5dm1RRzRnSkJUdU1IMjFuaWNQTVhLRVNGK3RURkJEZW8K",
      "endpoints": [
        "https://github.com/Lin-H/2fa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}